{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/Students%20Social%20Media%20Addiction.csv"},
  "transform": [
    {"aggregate": [{"op": "mean", "field": "Addicted_Score", "as": "addiction"}], "groupby": ["Country"]}
  ],
  "width": "container",
  "height": 120,
  "layer": [
    {
      "mark": "tick",
      "encoding": {
        "x": {
          "field": "addiction",
          "type": "quantitative",
          "title": "Mean Addiction Score",
          "scale": {"domain": [0, 10]},
          "axis": {"labelFontSize": 12, "titleFontSize": 13}
        },
        "color": {
          "condition": {"test": "datum.Country === 'Australia'", "value": "#2563eb"},
          "value": "#94a3b8"
        },
        "opacity": {
          "condition": {"test": "datum.Country === 'Australia'", "value": 1},
          "value": 0.6
        }
      }
    },
    {
      "transform": [{"filter": "datum.Country === 'Australia'"}],
      "mark": {"type": "text", "color": "#2563eb", "dy": -32, "fontWeight": "bold", "fontSize": 12, "clip": false},
      "encoding": {
        "x": {"field": "addiction", "type": "quantitative"},
        "text": {"value": "Australia"}
      }
    }
  ],
  "title": {
    "text": "Australia's Addiction Score vs the Globe",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 13, "domain": false, "gridOpacity": 0.25}
  }
}
