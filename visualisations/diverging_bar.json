{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/Students%20Social%20Media%20Addiction.csv"},
  "transform": [
    {"filter": "datum.Most_Used_Platform !== 'WeChat' && datum.Most_Used_Platform !== 'VKontakte' && datum.Most_Used_Platform !== 'LINE' && datum.Most_Used_Platform !== 'KakaoTalk' && datum.Most_Used_Platform !== 'WhatsApp'"},
    {"joinaggregate": [{"op": "count", "as": "platform_total"}], "groupby": ["Most_Used_Platform"]},
    {"calculate": "datum.Sleep_Hours_Per_Night < 7 ? -1 : 0", "as": "sleep_dep"},
    {"calculate": "datum.Affects_Academic_Performance === 'Yes' ? 1 : 0", "as": "acad_impact"},
    {"fold": ["sleep_dep", "acad_impact"], "as": ["metric", "value"]},
    {"calculate": "datum.metric === 'sleep_dep' ? 'Sleep Deprived' : 'Academic Impact'", "as": "type"},
    {
      "aggregate": [
        {"op": "sum", "field": "value", "as": "signed_sum"},
        {"op": "mean", "field": "platform_total", "as": "total"}
      ],
      "groupby": ["Most_Used_Platform", "type"]
    },
    {"calculate": "datum.signed_sum / datum.total * 100", "as": "signed_pct"},
    {"joinaggregate": [{"op": "min", "field": "signed_pct", "as": "sort_key"}], "groupby": ["Most_Used_Platform"]}
  ],
  "width": "container",
  "height": 300,
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "Most_Used_Platform",
      "type": "ordinal",
      "sort": {"field": "sort_key", "op": "min", "order": "ascending"},
      "title": null
    },
    "x": {
      "field": "signed_pct",
      "type": "quantitative",
      "title": "% of Students",
      "axis": {"format": "s"},
      "scale": {"domain": [-100, 100]}
    },
    "color": {
      "field": "type",
      "type": "nominal",
      "scale": {
        "domain": ["Sleep Deprived", "Academic Impact"],
        "range": ["#4a90d9", "#e05c47"]
      },
      "legend": {"orient": "top", "title": null}
    }
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  },
  "title": {
    "text": "Individual Platforms' Harm on Sleep and Academics",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  }
}
