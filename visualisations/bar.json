{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A bar chart showing average daily social media usage hours by platform, sorted highest to lowest.",
  "data": {"url": "data/Students%20Social%20Media%20Addiction.csv"},
  "transform": [
    {"filter": "datum.Most_Used_Platform !== 'WeChat' && datum.Most_Used_Platform !== 'VKontakte' && datum.Most_Used_Platform !== 'LinkedIn' && datum.Most_Used_Platform !== 'LINE' && datum.Most_Used_Platform !== 'KakaoTalk' && datum.Most_Used_Platform !== 'WhatsApp'"}
  ],
  "width": "container",
  "height": 300,
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "Most_Used_Platform",
      "type": "ordinal",
      "sort": "-x",
      "title": "Platform"
    },
    "x": {
      "aggregate": "mean",
      "field": "Avg_Daily_Usage_Hours",
      "title": "Avg Daily Usage (hours)",
      "axis": {"labelFontSize": 12, "titleFontSize": 13}
    },
    "color": {
      "aggregate": "mean",
      "field": "Avg_Daily_Usage_Hours",
      "type": "quantitative",
      "legend": null,
      "scale": {"scheme": "blues"}
    }
  },
  "title": {
    "text": "Which Platforms Have the Most Usage?",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFontSize": 12, "titleFontSize": 13, "domain": false, "gridOpacity": 0.25},
    "legend": {"labelFontSize": 11, "titleFontSize": 11}
  }
}
