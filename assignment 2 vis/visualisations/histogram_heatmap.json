{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {"url": "data/Students%20Social%20Media%20Addiction.csv"},
  "transform": [{"filter": {"and": [
    {"field": "Avg_Daily_Usage_Hours", "valid": true},
    {"field": "Mental_Health_Score", "valid": true}
  ]}}],
  "mark": "rect",
  "width": "container",
  "height": 300,
  "encoding": {
    "x": {
      "bin": {"step": 1},
      "field": "Avg_Daily_Usage_Hours",
      "type": "quantitative",
      "title": "Avg Daily Usage (hours)"
    },
    "y": {
      "bin": {"step": 1},
      "field": "Mental_Health_Score",
      "type": "quantitative",
      "title": "Mental Health Score"
    },
    "color": {
      "aggregate": "count",
      "type": "quantitative",
      "legend": {"title": "Students"}
    }
  },
  "title": {
    "text": "Correlation Between Screen Time and Mental Health",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  },
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {"labelFontSize": 12, "titleFontSize": 13, "domain": false, "gridOpacity": 0.25},
    "legend": {"labelFontSize": 11, "titleFontSize": 11}
  }
}
