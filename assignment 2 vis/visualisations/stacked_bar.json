{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "100% stacked bar \u2014 academic impact severity by social media usage group.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/Social_Media_Impact_OnStudents.csv"
  },
  "transform": [
    {
      "calculate": "trim(datum.SocialMediaHours)",
      "as": "UsageGroup"
    },
    {
      "calculate": "trim(datum.AcademicImpact)",
      "as": "Impact"
    },
    {
      "calculate": "datum.Impact === 'Rarely' ? 3 : datum.Impact === 'Sometimes' ? 2 : datum.Impact === 'Often' ? 1 : 0",
      "as": "ImpactOrder"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "UsageGroup",
      "type": "ordinal",
      "sort": [
        "Less than 1 hour",
        "1–3 hours",
        "More than 3 hours"
      ],
      "title": "Daily Social Media Usage",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "aggregate": "count",
      "stack": "normalize",
      "title": "Proportion of Students",
      "axis": {
        "format": "%"
      }
    },
    "color": {
      "field": "Impact",
      "type": "ordinal",
      "sort": [
        "Rarely",
        "Sometimes",
        "Often",
        "Always"
      ],
      "scale": {
        "domain": [
          "Rarely",
          "Sometimes",
          "Often",
          "Always"
        ],
        "range": [
          "#dbeafe",
          "#60a5fa",
          "#2563eb",
          "#1e3a8a"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "title": null
      }
    },
    "order": {
      "field": "ImpactOrder",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "UsageGroup",
        "type": "ordinal",
        "title": "Usage Group"
      },
      {
        "field": "Impact",
        "type": "ordinal",
        "title": "Academic Impact"
      },
      {
        "aggregate": "count",
        "title": "Students"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#333333",
      "titleColor": "#222222",
      "gridOpacity": 0.25,
      "domain": false
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11,
      "labelColor": "#333333",
      "titleColor": "#222222"
    }
  },
  "title": {
    "text": "How Much Are Students Affected?",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  }
}