{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
    "format": {
      "type": "topojson",
      "feature": "countries"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.id)",
      "as": "numid"
    },
    {
      "lookup": "numid",
      "from": {
        "data": {
          "url": "data/country_mental_health_scores.json"
        },
        "key": "id",
        "fields": [
          "mental_health",
          "country"
        ]
      }
    }
  ],
  "projection": {
    "type": "naturalEarth1"
  },
  "layer": [
    {
      "mark": "geoshape",
      "encoding": {
        "color": {
          "condition": {
            "test": "isValid(datum.mental_health)",
            "field": "mental_health",
            "type": "quantitative",
            "title": "Mental Health Score",
            "scale": {
              "scheme": "reds",
              "domain": [
                4,
                9
              ]
            },
            "legend": {
              "orient": "bottom-left",
              "gradientLength": 120,
              "labelFontSize": 11,
              "titleFontSize": 12
            }
          },
          "value": "#d9dde8"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.numid === 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#0d1b3e",
        "strokeWidth": 2.5
      }
    }
  ],
  "title": {
    "text": "Student Mental Health Across the Globe",
    "fontSize": 15,
    "fontWeight": 700,
    "anchor": "start",
    "color": "#0d1b3e",
    "offset": 10
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}